# Frontend (Vite) — Supabase Auth only
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_or_publishable_key
VITE_API_URL=http://127.0.0.1:4000

# Supabase Auth verification (Express)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your_anon_or_publishable_key
SUPABASE_JWT_SECRET=your_jwt_secret_from_supabase_settings
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
# Used by Express → Edge Function SQL bridge (auto-set if missing during setup)
CELERITY_BRIDGE_SECRET=generate_a_long_random_string
ADMIN_BOOTSTRAP_EMAILS=you@example.com

# Express API
API_PORT=4000
CORS_ORIGIN=http://127.0.0.1:3001,http://localhost:3001

# Aiven PostgreSQL (source of truth for commerce)
DATABASE_URL=postgres://USER:PASSWORD@HOST:PORT/DEFDB?sslmode=require
# Or discrete:
# PGHOST=
# PGPORT=5432
# PGUSER=
# PGPASSWORD=
# PGDATABASE=
# PGSSL=true

# Aiven Kafka
KAFKA_BROKERS=host:port
KAFKA_USERNAME=
KAFKA_PASSWORD=
KAFKA_SSL=true
KAFKA_SASL_MECHANISM=scram-sha-256
KAFKA_TOPIC=aiven.celerity.inventory-events

# Aiven OpenSearch
OPENSEARCH_URL=https://host:port
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=
OPENSEARCH_INDEX=celerity-products

# WhatsApp Business Cloud API
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=en

# Optional Qwen via Ollama (admin explanations only)
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b

# Workers
OUTBOX_POLL_MS=3000
OUTBOX_BATCH=20
DEAD_STOCK_DAYS=30
