{
  "name": "celerity-commerce",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "api": "tsx server/src/index.ts",
    "db:migrate": "tsx server/src/db/migrate.ts",
    "db:reindex": "tsx -e \"import { reindexAllFromPostgres } from './server/src/services/search.ts'; reindexAllFromPostgres().then(c=>{console.log('indexed',c);process.exit(0)}).catch(e=>{console.error(e);process.exit(1)})\"",
    "worker:outbox": "tsx server/src/workers/outboxPublisher.ts",
    "worker:search": "tsx server/src/workers/searchConsumer.ts",
    "worker:inventory": "tsx server/src/workers/inventoryRestockConsumer.ts",
    "supabase:start": "npx supabase start",
    "supabase:stop": "npx supabase stop",
    "db:push": "npx supabase db push",
    "functions:serve": "npx supabase functions serve --env-file .env",
    "functions:deploy": "npx supabase functions deploy",
    "worker:outbox:legacy": "node server/workers/outboxPublisher.js",
    "pipeline:smoke": "node server/scripts/smoke-pipeline.js"
  },
  "dependencies": {
    "@opensearch-project/opensearch": "^3.10.0",
    "@supabase/supabase-js": "^2.119.2",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "csv-parse": "^7.0.3",
    "dotenv": "^16.6.1",
    "exceljs": "^4.4.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "framer-motion": "^12.4.7",
    "gsap": "^3.12.7",
    "helmet": "^8.3.0",
    "jose": "^6.2.18",
    "jszip": "^3.10.2",
    "kafkajs": "^2.2.4",
    "lucide-react": "^1.16.0",
    "multer": "^2.5.0",
    "pg": "^8.23.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.2",
    "uuid": "^14.0.3",
    "xlsx": "^0.18.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.13.4",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  }
}
